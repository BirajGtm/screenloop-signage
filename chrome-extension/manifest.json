{
  "manifest_version": 3,
  "name": "ScreenLoop Signage",
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "version": "1.5.3",
  "options_page": "options.html",
  "minimum_chrome_version": "120",
  "description": "Turn browser tabs into a signage playlist with timed rotation, refresh, and a customizable countdown bar.",
  "permissions": ["alarms", "storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "ScreenLoop Signage", "default_popup": "popup.html", "default_icon":{"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png"}}
}
